rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email == 'tudeliveryd@gmail.com' && request.auth.token.email_verified == true; }
    function rolesDoc() { return /databases/$(database)/documents/config/roles; }
    function isSocio() { return signedIn() && exists(rolesDoc()) && request.auth.uid in get(rolesDoc()).data.get('socios', []); }
    function isAdmin() { return isOwner() || isSocio(); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function approved(uid) {
      let p = get(/databases/$(database)/documents/turnos/$(uid)).data;
      return p.get('aprobado', false) == true && p.get('baja', false) != true;
    }
    match /config/roles { allow read: if signedIn(); allow write: if isOwner(); }
    match /config/{doc} { allow read, write: if isAdmin(); }
    match /turnos/{uid} {
      allow read: if isAdmin() || isMe(uid);
      allow create: if isAdmin() || (isMe(uid) && request.resource.data.get('aprobado', false) == false && request.resource.data.get('baja', false) == false);
      allow update: if isAdmin() || (isMe(uid) && request.resource.data.get('aprobado', false) == resource.data.get('aprobado', false) && request.resource.data.get('baja', false) == resource.data.get('baja', false));
      allow delete: if isOwner();
      match /gastos/{id} { allow read, write: if isMe(uid) && (isAdmin() || approved(uid)); }
      match /entregas/{id} {
        allow read: if isAdmin() || isMe(uid);
        allow create: if isAdmin() || (isMe(uid) && approved(uid));
        allow update, delete: if isAdmin() || (isMe(uid) && approved(uid) && resource.data.get('estado', '') == 'camino');
      }
      match /{sub}/{id} {
        allow read: if sub != 'gastos' && (isAdmin() || isMe(uid));
        allow write: if sub != 'gastos' && sub != 'entregas' && (isAdmin() || (isMe(uid) && approved(uid)));
      }
    }
    match /liq/{uid}/{rest=**} { allow read: if isAdmin() || isMe(uid); allow write: if isAdmin(); }
    match /ranking/{uid} {
      allow read: if isAdmin() || (signedIn() && approved(request.auth.uid));
      allow write: if isAdmin() || (isMe(uid) && approved(uid));
    }
    match /empresa/{rest=**} { allow read, write: if isAdmin(); }
  }
}
